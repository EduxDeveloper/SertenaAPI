PORT=4000
NODE_ENV=development
DB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>/<base-de-datos>
JWT_Secret_key=generar-un-secreto-largo-y-aleatorio
# SMTP de Gmail se conserva como referencia, pero no se usa en Render porque
# Render bloquea los puertos SMTP salientes.
# USER_EMAIL=cuenta@gmail.com
# USER_PASSWORD=contrasena-de-aplicacion-de-gmail

# Variables de Mailjet
API_KEY_MAILJET=tu_api_key_aqui
API_SECRET_MAILJET=tu_secret_key_aqui
MAILJET_FROM_EMAIL=tucorreo@example.com
MAILJET_FROM_NAME=Soporte SERTENA


CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Separa las URLs de las dos aplicaciones web con comas.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
